/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./",
    "paths": {
      "@shared": [
        "src/app/shared/index"
      ],
      "@core": [
        "src/app/core/index"
      ],
      "@env/*": [
        "src/environments/*"
      ],
      "@_mock": [
        "_mock/index"
      ],
      /*
       * `package.json` installs `date-fns-jalali` under the alias `date-fns`, so that ng-zorro's own
       * `date-fns` imports resolve to it and the date-picker becomes Jalali (see
       * `scripts/dedupe-date-fns.mjs`). But the package's ~3000 type declarations are ambient and
       * keyed to its real name — `declare module 'date-fns-jalali'` — so importing the alias name
       * yields `TS2306: ... is not a module`.
       *
       * Mapping the real name onto the aliased folder lets our own code import `date-fns-jalali`
       * and get correct types, while still sharing the single physical copy with ng-zorro. Adding
       * `date-fns-jalali` as a second dependency would type-check too, but would put a duplicate
       * copy of the library in the bundle.
       */
      "date-fns-jalali": [
        "node_modules/date-fns"
      ],
      "date-fns-jalali/locale": [
        "node_modules/date-fns/locale"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
